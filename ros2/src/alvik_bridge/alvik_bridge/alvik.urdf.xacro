<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="alvik">

  <!-- ── Parametri ──────────────────────────────────────────────────────── -->
  <xacro:property name="body_length" value="0.095"/>  <!-- m, fronte-retro -->
  <xacro:property name="body_width"  value="0.096"/>  <!-- m, sinistra-destra -->
  <xacro:property name="body_height" value="0.037"/>  <!-- m, altezza -->

  <xacro:property name="wheel_radius" value="0.017"/>  <!-- m -->
  <xacro:property name="wheel_width"  value="0.005"/>  <!-- m -->
  <xacro:property name="base_width"   value="0.090"/>  <!-- m, centro-centro ruote -->

  <xacro:property name="tof_x"   value="0.048"/>   <!-- m, frontale dal centro -->
  <xacro:property name="tof_z"   value="0.020"/>   <!-- m, altezza dal suolo -->

  <xacro:property name="caster_x" value="-0.040"/> <!-- m, posteriore -->

  <!-- ── Materiali ──────────────────────────────────────────────────────── -->
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.4 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ── base_footprint ────────────────────────────────────────────────── -->
  <!-- Link a terra — punto di riferimento Nav2 -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ── base_link — corpo principale ─────────────────────────────────── -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.192"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(0.192/12) * (body_width*body_width + body_height*body_height)}"
        iyy="${(0.192/12) * (body_length*body_length + body_height*body_height)}"
        izz="${(0.192/12) * (body_length*body_length + body_width*body_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ── Macro ruota ───────────────────────────────────────────────────── -->
  <xacro:macro name="wheel" params="name side reflect">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.020"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${(0.020/12) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${(0.020/12) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${(0.020/2) * wheel_radius*wheel_radius}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="0 ${reflect * base_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left"  side="left"  reflect="1"/>
  <xacro:wheel name="right" side="right" reflect="-1"/>

  <!-- ── Castoro posteriore ────────────────────────────────────────────── -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${wheel_radius * 0.5}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${wheel_radius * 0.5}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(2.0/5.0) * 0.005 * (wheel_radius*0.5)*(wheel_radius*0.5)}"
        iyy="${(2.0/5.0) * 0.005 * (wheel_radius*0.5)*(wheel_radius*0.5)}"
        izz="${(2.0/5.0) * 0.005 * (wheel_radius*0.5)*(wheel_radius*0.5)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-wheel_radius * 0.5}" rpy="0 0 0"/>
  </joint>

  <!-- ── Sensore ToF frontale ───────────────────────────────────────────── -->
  <link name="tof_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.010 0.005"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="tof_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="tof_link"/>
    <origin xyz="${tof_x} 0 ${tof_z}" rpy="0 0 0"/>
  </joint>

  <!-- ── Frame laser scan (coincide con tof_link per /scan) ────────────── -->
  <link name="laser_frame"/>

  <joint name="laser_joint" type="fixed">
    <parent link="tof_link"/>
    <child  link="laser_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
