  <diagram name="Architettura v1.7 - Bridge Unificato" id="arch_v17">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITOLO -->
        <mxCell id="title" value="Alvik Digital Twin v1.7 — Architettura Bridge Unificato" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- HARDWARE LAYER -->
        <mxCell id="hw_container" value="HARDWARE LAYER" style="swimlane;startSize=30;fillColor=#f9dbc8;strokeColor=#d85a30;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="alvik" value="Arduino Alvik (ESP32 + STM32)&#xa;192.168.4.1:5005&#xa;&#xa;• Firmware C++ RT&#xa;• Telemetria CSV 50Hz UDP&#xa;• Motor Control / Odometria STM32&#xa;• Sensori: ToF ×5, Encoder, IMU&#xa;• Watchdog CMD 500ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9dbc8;strokeColor=#d85a30;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="hw_container">
          <mxGeometry x="10" y="40" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- MIDDLEWARE UNIFICATO -->
        <mxCell id="bridge_container" value="MIDDLEWARE — bridge_v1_7.py  (unico processo Python)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#1d9e75;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="330" width="1020" height="250" as="geometry" />
        </mxCell>

        <!-- Thread DDS -->
        <mxCell id="dds_thread" value="Thread DDS  (RT 50Hz)&#xa;&#xa;• Riceve CSV da Alvik UDP :5005&#xa;• Parsing 12 campi:&#xa;  x,y,θ,wl,wr,5×ToF,TickId,t_ms&#xa;• Tick master 50Hz&#xa;• Broadcast DDS binario :4444 → Godot&#xa;• Broadcast DDS binario :4445 → ROS2&#xa;• Invia CMD → Alvik UDP :5005&#xa;• Riceve /cmd_vel ← ROS2 UDP :5006&#xa;• Legge asyncio.Queue (CMD da WS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#1d9e75;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="bridge_container">
          <mxGeometry x="20" y="40" width="300" height="190" as="geometry" />
        </mxCell>

        <!-- asyncio.Queue -->
        <mxCell id="queue" value="asyncio.Queue&#xa;(CMD thread-safe)&#xa;&#xa;DDS Thread → WS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="bridge_container">
          <mxGeometry x="340" y="95" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- asyncio WS -->
        <mxCell id="ws_thread" value="asyncio event loop&#xa;&#xa;• Server WebSocket :8765 ↔ Godot&#xa;• Riceve: waypoint, path, teleop,&#xa;  stop, reset, alignment,&#xa;  explorer/slam/nav2 start/stop&#xa;• Passa CMD → asyncio.Queue&#xa;• subprocess → Docker ROS2&#xa;• Log e feedback → Godot&#xa;• Path following a 20Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#1d9e75;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="bridge_container">
          <mxGeometry x="520" y="40" width="280" height="190" as="geometry" />
        </mxCell>

        <!-- Log su file -->
        <mxCell id="log_file" value="Log su file&#xa;/log/bridge_YYYYMMDD.log&#xa;Max 100MB — rotazione auto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="bridge_container">
          <mxGeometry x="820" y="95" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Frecce interne bridge -->
        <mxCell id="qi1" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="bridge_container" source="dds_thread" target="queue">
          <mxGeometry relative="1" as="geometry" />
