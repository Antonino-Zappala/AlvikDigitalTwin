        <!-- GODOT DDS -->
        <mxCell id="godot_dds_c" value="VISUALIZATION — Godot Engine 4" style="swimlane;startSize=30;fillColor=#e8d5f9;strokeColor=#534ab7;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="godot_dds" value="DDS_v1_7.gd (Autoload)&#xa;UDP :4444&#xa;&#xa;• Riceve posa, ToF, TickId 50Hz&#xa;• Sync con TickId (no duplicati)&#xa;• Aggiorna Digital Twin 3D&#xa;• Raggi ToF, label posa&#xa;• Stato connessione Bridge/Alvik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5f9;strokeColor=#534ab7;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="godot_dds_c">
          <mxGeometry x="10" y="40" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- GODOT WS -->
        <mxCell id="godot_ws_c" value="CONTROL — Godot Engine 4" style="swimlane;startSize=30;fillColor=#e8d5f9;strokeColor=#534ab7;fontSize=12;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="670" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="godot_ws" value="selezione_waypoint_v1_7.gd&#xa;WebSocket :8765&#xa;&#xa;• Invia: waypoint, path, teleop,&#xa;  stop, reset, alignment,&#xa;  explorer/slam/nav2 start/stop&#xa;• Riceve: log, feedback, ack&#xa;• Modalità: TELEOP, WAYPOINT,&#xa;  PATH, ALIGN, EXPLORER,&#xa;  SLAM, NAV2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5f9;strokeColor=#534ab7;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="godot_ws_c">
          <mxGeometry x="10" y="40" width="300" height="170" as="geometry" />
        </mxCell>

        <!-- DOCKER ROS2 -->
        <mxCell id="docker_c" value="DOCKER — Container &quot;alvik_ros2&quot;  ROS2 Humble  [opzionale: Esploratore / Nav2 / Calibrazione PID]" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#185fa5;fontSize=12;fontStyle=1;rounded=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="300" y="670" width="720" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ros_bridge" value="alvik_ros_bridge.py&#xa;&#xa;• Riceve DDS UDP :4445&#xa;• Pubblica /odom /tf (100Hz) /scan&#xa;• TF continuo → evita gap WiFi&#xa;• theta = alvik_theta + π&#xa;• pos = -alvik_pos (negato)&#xa;• /cmd_vel → UDP :5006 → bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#185fa5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="docker_c">
          <mxGeometry x="10" y="40" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="slam" value="slam_toolbox&#xa;&#xa;• /map&#xa;• Odometria pura&#xa;• use_scan_matching:&#xa;  false&#xa;• max_laser_range: 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#185fa5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="docker_c">
          <mxGeometry x="225" y="40" width="150" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nav2" value="Nav2 stack&#xa;&#xa;• AMCL&#xa;• bt_navigator&#xa;• controller_server&#xa;  (PurePursuit)&#xa;• planner_server&#xa;  (NavfnPlanner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#185fa5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="docker_c">
          <mxGeometry x="390" y="40" width="150" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pid" value="alvik_pid_controller.py&#xa;&#xa;• PID posizione&#xa;• ROTATING → MOVING&#xa;  → ADJUSTING&#xa;• /pid_debug&#xa;  → PlotJuggler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="docker_c">
          <mxGeometry x="555" y="40" width="150" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rviz" value="RViz2&#xa;Fixed Frame: map&#xa;/map /tf /scan /odom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#185fa5;fontSize=11;" vertex="1" parent="docker_c">
          <mxGeometry x="225" y="210" width="480" height="50" as="geometry" />
        </mxCell>

